# CreatorBrief — copy to .env for local dev (never commit .env)
#
# IMPORTANT: Run influenceOS-hackathon-backend (NOT InfluenceOS-backend).
# Vite proxies /api to VITE_API_PROXY_TARGET (default http://localhost:3000).

# Leave empty in local dev: browser calls /api on the Vite port; Vite proxies to the hackathon backend.
# For production builds, set to your deployed hackathon API URL (e.g. https://your-hackathon-api.onrender.com).
VITE_API_URL=

# Dev/preview proxy target — hackathon API on port 3000 (see influenceOS-hackathon-backend).
VITE_API_PROXY_TARGET=http://localhost:3000

# Default platform in the UI is YouTube (set in SearchPanel); no env var required.

# Optional public gate keys (bundled into the client — NOT secret).
# Only set when the hackathon backend has ENRICHMENT_API_KEY / DISCOVERY_API_KEY enabled.
# VITE_ENRICHMENT_API_KEY=
# VITE_DISCOVERY_API_KEY=
