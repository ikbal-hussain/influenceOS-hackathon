# Copy to .env for local dev (never commit .env)

# Leave empty in local dev: the browser calls /api on the Vite port and Vite proxies to the backend (no CORS).
# For production builds, set to your deployed API (e.g. https://influenceos-backend.onrender.com).
# Optional: http://localhost:3000 — works if the backend allows your dev origin (loopback is allowed).
VITE_API_URL=

# Optional: only used by Vite's dev proxy for /api requests. Defaults to http://localhost:3000.
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional public gate keys (bundled into the client — NOT secret; anyone can read them in built JS).
# Only set when the backend has ENRICHMENT_API_KEY / DISCOVERY_API_KEY enabled; use the same values.
# VITE_ENRICHMENT_API_KEY=
# VITE_DISCOVERY_API_KEY=
